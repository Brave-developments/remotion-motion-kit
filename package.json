{
  "name": "remotion-motion-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone curated Remotion motion graphics and source collection for Brave Developments",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "render:demo": "remotion render src/index.ts MotionKitDemo out/motion-kit-demo.mp4",
    "remotion:ensure": "remotion browser ensure",
    "render:editorial": "remotion render src/index.ts EditorialMotionDemo out/editorial-motion-demo.mp4",
    "render:healthcare": "remotion render src/index.ts HealthcareDemo out/healthcare-demo.mp4",
    "render:healthcare3d": "remotion render src/index.ts Healthcare3DDemo out/healthcare-3d-demo.mp4",
    "render:healthcare-premium": "remotion render src/index.ts HealthcarePremiumDemo out/healthcare-premium-demo.mp4"
  },
  "dependencies": {
    "remotion": "4.0.534",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.534",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
